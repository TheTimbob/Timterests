package web

import (
	"strconv"
	"timterests/internal/storage"
)

templ AdminDocumentsPage(params AdminDocumentsParams) {
	@Base("admin") {
		@AdminDocumentsDisplay(params)
	}
}

templ AdminDocumentsDisplay(params AdminDocumentsParams) {
	<div id="admin-documents-container">
		<h1 class="category-title">Documents</h1>
		@AdminDocumentsTable(params)
	</div>
}

templ AdminDocumentsTable(params AdminDocumentsParams) {
	<div id="documents-table-wrapper" class="card-container-static">
		<form
			hx-get="/admin/documents"
			hx-target="#documents-table-wrapper"
			hx-swap="outerHTML"
			class="admin-search-form"
		>
			<input type="hidden" name="sort" value={ params.SortBy }/>
			<input type="hidden" name="dir" value={ params.SortDir }/>
			<input
				type="text"
				name="q"
				value={ params.Query }
				placeholder="Search by filename..."
				class="form-input admin-search-input"
			/>
			<select name="type" class="filter-select admin-filter" aria-label="Filter by document type">
				<option value="">All types</option>
				for _, t := range params.DocTypes {
					<option value={ t } selected?={ params.DocType == t }>{ t }</option>
				}
			</select>
			<input
				type="date"
				name="from"
				value={ params.From }
				class="form-input admin-filter"
				aria-label="Modified from"
			/>
			<input
				type="date"
				name="to"
				value={ params.To }
				class="form-input admin-filter"
				aria-label="Modified to"
			/>
			<button type="submit" class="button">Apply</button>
			if params.Query != "" || params.DocType != "" || params.From != "" || params.To != "" {
				<a href="/admin/documents" class="button button-sm admin-filter-clear">Clear</a>
			}
		</form>
            <div class="admin-table-wrapper">
			<table class="admin-table">
				<thead>
					<tr>
						<th>@adminSortLink("filename", "Filename", params)</th>
						<th>Type</th>
						<th>Source</th>
						<th>Size</th>
						<th>@adminSortLink("modified", "Last Modified", params)</th>
						<th>Actions</th>
					</tr>
				</thead>
				<tbody>
					for _, doc := range params.Docs {
						<tr>
							<td>{ doc.Filename }</td>
							<td>{ doc.DocType }</td>
							<td>{ doc.Source }</td>
							<td>{ storage.FormatFileSize(doc.Size) }</td>
							<td>{ doc.LastModified.Format("2006-01-02 15:04") }</td>
							<td class="admin-row-actions">
								<form method="POST" action="/writer" class="action-form">
									<input type="hidden" name="document-type" value={ doc.DocType }/>
									<input type="hidden" name="document-key" value={ doc.Key }/>
									<input type="hidden" name="type-id" value={ strconv.Itoa(doc.Index) }/>
									<button type="submit" class="button button-sm">Edit</button>
								</form>
								<form
									class="action-form"
									hx-post="/admin/documents/delete"
									hx-target="#documents-table-wrapper"
									hx-swap="outerHTML"
									hx-confirm={ "Delete " + doc.Filename + "? This removes the document and cannot be undone." }
								>
									<input type="hidden" name="key" value={ doc.Key }/>
									<button type="submit" class="button button-sm button-danger">Delete</button>
								</form>
							</td>
						</tr>
					}
					if len(params.Docs) == 0 {
						<tr>
							<td colspan="6" class="admin-table-empty">No documents found.</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
		if params.TotalPages > 1 {
			<div class="admin-pagination">
				if params.Page > 1 {
					<a href={ templ.SafeURL(buildDocumentsURL(params, params.SortBy, params.SortDir, params.Page-1)) } class="button button-sm" hx-get={ buildDocumentsURL(params, params.SortBy, params.SortDir, params.Page-1) } hx-target="#documents-table-wrapper" hx-swap="outerHTML">← Previous</a>
	}
				<span class="admin-page-info">Page { strconv.Itoa(params.Page) } of { strconv.Itoa(params.TotalPages) }</span>
				if params.Page < params.TotalPages {
					<a href={ templ.SafeURL(buildDocumentsURL(params, params.SortBy, params.SortDir, params.Page+1)) } class="button button-sm" hx-get={ buildDocumentsURL(params, params.SortBy, params.SortDir, params.Page+1) } hx-target="#documents-table-wrapper" hx-swap="outerHTML">Next →</a>
				}
			</div>
		}
	</div>
}

templ adminSortLink(field, label string, params AdminDocumentsParams) {
	if params.SortBy == field {
		if params.SortDir == "asc" {
			<a href={ templ.SafeURL(buildDocumentsURL(params, field, "desc", 1)) } hx-get={ buildDocumentsURL(params, field, "desc", 1) } hx-target="#documents-table-wrapper" hx-swap="outerHTML">{ label } ▲</a>
		} else {
			<a href={ templ.SafeURL(buildDocumentsURL(params, field, "asc", 1)) } hx-get={ buildDocumentsURL(params, field, "asc", 1) } hx-target="#documents-table-wrapper" hx-swap="outerHTML">{ label } ▼</a>
		}
	} else {
		<a href={ templ.SafeURL(buildDocumentsURL(params, field, "asc", 1)) } hx-get={ buildDocumentsURL(params, field, "asc", 1) } hx-target="#documents-table-wrapper" hx-swap="outerHTML">{ label }</a>
	}
}
