package web

templ LoginPage(errorMsg string) {
	@Base("login") {
		@LoginContainer(errorMsg)
	}
}

templ LoginContainer(errorMsg string) {
	<div id="login-container" class="login-card">
		<img src="/assets/images/logo.png" alt="" aria-hidden="true" class="login-logo"/>
		<h1 class="login-title">Sign in</h1>
		<p class="login-subtitle">Admin access to { Site().Name }</p>
		if errorMsg != "" {
			<p class="error-message" role="alert">{ errorMsg }</p>
		}
		if OIDCEnabled() {
			<a href="/auth/login" class="button login-button">
				<i class="fa-brands fa-google" aria-hidden="true"></i> Continue with Google
			</a>
			<p class="login-note">Restricted to approved accounts.</p>
		} else {
			<p class="login-note">Sign-in is not configured.</p>
		}
	</div>
}
